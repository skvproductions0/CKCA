generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== SCHOOLS & MULTI-TENANCY ====================

model School {
  id                 String    @id @default(uuid())
  name               String
  shortCode          String    @default("CKCA")
  code               String    @unique
  status             String    @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED
  address            String?
  city               String?
  state              String?
  pincode            String?
  phone              String?
  email              String?
  website            String?
  board              String?   @default("CBSE") // CBSE, ICSE, State, etc.
  affiliationNumber  String?
  principalName      String?
  logoPath           String?
  faviconPath        String?
  signaturePath      String?
  stampPath          String?
  primaryColor       String    @default("#2563eb")
  secondaryColor     String    @default("#1e40af")
  reportHeader       String?
  reportFooter       String?
  maxStudents        Int       @default(1000)
  maxStaff           Int       @default(100)
  licenseExpiresAt   DateTime?
  maintenanceMode    Boolean   @default(false)
  maintenanceMessage String?
  plan               String    @default("PREMIUM") // BASIC, STANDARD, PREMIUM, CUSTOM
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  features           SchoolFeature[]
  users              User[]
  schoolSettings     SchoolSetting[]
  gradingRules       GradingRule[]
  feeCategories      FeeCategory[]
  academicYears      AcademicYear[]
  classes            Class[]
  sections           Section[]
  teachers           Teacher[]
  students           Student[]
  admissions         Admission[]
  subjects           Subject[]
  feeStructures      FeeStructure[]
  studentFees        StudentFee[]
  feePayments        FeePayment[]
  attendances        Attendance[]
  exams              Exam[]
  results            Result[]
  documents          Document[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  receiptCounters    ReceiptCounter[]
  admissionCounters  AdmissionCounter[]
}

// ==================== AUTH & USERS ====================

model User {
  id           String    @id @default(uuid())
  schoolId     String?
  username     String    @unique
  email        String    @unique
  passwordHash String
  fullName     String
  role                String    @default("TEACHER")
  isActive            Boolean   @default(true)
  isLocked            Boolean   @default(false)
  lockReason          String?
  forcePasswordChange Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school        School?        @relation(fields: [schoolId], references: [id])
  auditLogs     AuditLog[]
  feePayments   FeePayment[]
  sessions      Session[]
  teacher       Teacher?
  notifications Notification[]

  @@index([schoolId])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  device       String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ==================== SCHOOL SETTINGS ====================

model SchoolSetting {
  id                 String   @id @default(uuid())
  schoolId           String?
  schoolName         String   @default("ABC Public School Management System")
  logoPath           String?
  address            String?
  phone              String?
  email              String?
  website            String?
  principalName      String?
  registrationNumber String?
  receiptFooter      String?
  reportCardFooter   String?
  currencySymbol     String   @default("₹")
  enableRanking      Boolean  @default(true)
  backupSchedule     String   @default("weekly")
  backupLocation     String?
  autoBackupEnabled  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

model GradingRule {
  id          String   @id @default(uuid())
  schoolId    String?
  grade       String
  minPercent  Float
  maxPercent  Float
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id])

  @@unique([grade])
  @@index([schoolId])
}

model FeeCategory {
  id          String   @id @default(uuid())
  schoolId    String?
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school            School?            @relation(fields: [schoolId], references: [id])
  feeStructureItems FeeStructureItem[]
  feePayments       FeePayment[]

  @@index([schoolId])
}

// ==================== ACADEMIC YEAR ====================

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String?
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  isActive  Boolean  @default(true)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School?        @relation(fields: [schoolId], references: [id])
  students      Student[]
  admissions    Admission[]
  feeStructures FeeStructure[]
  studentFees   StudentFee[]
  feePayments   FeePayment[]
  attendances   Attendance[]
  exams         Exam[]
  results       Result[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// ==================== CLASSES & SECTIONS ====================

model Class {
  id           String    @id @default(uuid())
  schoolId     String?
  name         String
  numericOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school        School?        @relation(fields: [schoolId], references: [id])
  sections      Section[]
  students      Student[]
  subjects      Subject[]
  feeStructures FeeStructure[]
  exams         Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id             String    @id @default(uuid())
  schoolId       String?
  name           String
  classId        String
  classTeacherId String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  school       School?      @relation(fields: [schoolId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  classTeacher Teacher?     @relation(fields: [classTeacherId], references: [id])
  students     Student[]
  attendances  Attendance[]
  exams        Exam[]

  @@unique([classId, name])
  @@index([classId])
  @@index([schoolId])
}

// ==================== TEACHERS ====================

model Teacher {
  id               String    @id @default(uuid())
  schoolId         String?
  employeeId       String
  userId           String?   @unique
  name             String
  fatherName       String?
  motherName       String?
  dateOfBirth      DateTime?
  gender           String?
  phone            String?
  email            String?
  address          String?
  qualification    String?
  subject          String?
  joiningDate      DateTime?
  salaryPaise      Int       @default(0)
  photoPath        String?
  emergencyContact String?
  status           String    @default("ACTIVE")
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  school   School?   @relation(fields: [schoolId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  sections Section[]
  subjects Subject[]

  @@unique([schoolId, employeeId])
  @@index([name])
  @@index([status])
  @@index([schoolId])
}

// ==================== STUDENTS ====================

model Student {
  id               String    @id @default(uuid())
  schoolId         String?
  studentId        String
  admissionNumber  String
  name             String
  fatherName       String?
  fatherMobile     String?
  fatherOccupation String?
  fatherEmail      String?
  motherName       String?
  motherMobile     String?
  motherOccupation String?
  motherEmail      String?
  guardianName     String?
  guardianMobile   String?
  guardianEmail    String?
  guardianRelation String?
  dateOfBirth      DateTime?
  gender           String?
  bloodGroup       String?
  aadhaarNumber    String?
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  classId          String?
  sectionId        String?
  rollNumber       String?
  admissionDate    DateTime?
  academicYearId   String?
  photoPath        String?
  emergencyContact String?
  previousSchool   String?
  previousClass    String?
  tcNumber         String?
  remarks          String?
  status           String    @default("ACTIVE")
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  school       School?       @relation(fields: [schoolId], references: [id])
  class        Class?        @relation(fields: [classId], references: [id])
  section      Section?      @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  studentFees StudentFee[]
  feePayments FeePayment[]
  attendances Attendance[]
  results     Result[]
  documents   Document[]
  admissions  Admission[]

  @@unique([schoolId, studentId])
  @@unique([schoolId, admissionNumber])
  @@index([name])
  @@index([admissionNumber])
  @@index([classId])
  @@index([sectionId])
  @@index([academicYearId])
  @@index([status])
  @@index([schoolId])
}

// ==================== ADMISSIONS ====================

model Admission {
  id               String    @id @default(uuid())
  schoolId         String?
  studentId        String?
  academicYearId   String
  admissionNumber  String
  name             String
  fatherName       String?
  fatherMobile     String?
  fatherOccupation String?
  fatherEmail      String?
  motherName       String?
  motherMobile     String?
  motherOccupation String?
  motherEmail      String?
  guardianName     String?
  guardianMobile   String?
  guardianEmail    String?
  guardianRelation String?
  dateOfBirth      DateTime?
  gender           String?
  bloodGroup       String?
  aadhaarNumber    String?
  phone            String?
  email            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  previousSchool   String?
  previousClass    String?
  tcNumber         String?
  classId          String?
  sectionId        String?
  rollNumber       String?
  admissionDate    DateTime  @default(now())
  status           String    @default("PENDING")
  metadata         String?
  photoPath        String?
  remarks          String?
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  school       School?      @relation(fields: [schoolId], references: [id])
  student      Student?     @relation(fields: [studentId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([schoolId, studentId])
  @@unique([schoolId, admissionNumber])
  @@index([academicYearId])
  @@index([status])
  @@index([schoolId])
}

// ==================== SUBJECTS ====================

model Subject {
  id           String    @id @default(uuid())
  schoolId     String?
  name         String
  code         String
  classId      String
  maxMarks     Int       @default(100)
  passingMarks Int       @default(40)
  teacherId    String?
  isActive     Boolean   @default(true)
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  school  School?  @relation(fields: [schoolId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  results Result[]

  @@unique([classId, code])
  @@index([classId])
  @@index([schoolId])
}

// ==================== FEES ====================

model FeeStructure {
  id             String   @id @default(uuid())
  schoolId       String?
  name           String
  academicYearId String
  classId        String?
  studentId      String?
  totalPaise     Int      @default(0)
  isActive       Boolean  @default(true)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School?            @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  class        Class?             @relation(fields: [classId], references: [id])
  items        FeeStructureItem[]
  studentFees  StudentFee[]

  @@index([academicYearId])
  @@index([classId])
  @@index([schoolId])
}

model FeeStructureItem {
  id             String @id @default(uuid())
  feeStructureId String
  feeCategoryId  String
  amountPaise    Int

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id])

  @@unique([feeStructureId, feeCategoryId])
}

model StudentFee {
  id               String   @id @default(uuid())
  schoolId         String?
  studentId        String
  feeStructureId   String?
  academicYearId   String
  totalPaise       Int      @default(0)
  paidPaise        Int      @default(0)
  discountPaise    Int      @default(0)
  previousDuePaise Int      @default(0)
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school       School?       @relation(fields: [schoolId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([schoolId])
}

model FeePayment {
  id               String   @id @default(uuid())
  schoolId         String?
  receiptNumber    String   @unique
  studentId        String
  academicYearId   String
  feeCategoryId    String?
  amountPaise      Int
  paymentDate      DateTime @default(now())
  paymentMethod    String   @default("CASH")
  previousDuePaise Int      @default(0)
  currentDuePaise  Int      @default(0)
  remarks          String?
  collectedById    String?
  status           String   @default("COMPLETED")
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school       School?       @relation(fields: [schoolId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  feeCategory  FeeCategory?  @relation(fields: [feeCategoryId], references: [id])
  collectedBy  User?         @relation(fields: [collectedById], references: [id])

  @@index([studentId])
  @@index([paymentDate])
  @@index([receiptNumber])
  @@index([academicYearId])
  @@index([schoolId])
}

// ==================== ATTENDANCE ====================

model Attendance {
  id             String   @id @default(uuid())
  schoolId       String?
  studentId      String
  sectionId      String
  academicYearId String
  date           DateTime
  status         String   @default("PRESENT")
  remarks        String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School?      @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, date])
  @@index([sectionId, date])
  @@index([academicYearId])
  @@index([schoolId])
}

// ==================== EXAMS & RESULTS ====================

model Exam {
  id             String   @id @default(uuid())
  schoolId       String?
  name           String
  academicYearId String
  classId        String
  sectionId      String?
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School?      @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  section      Section?     @relation(fields: [sectionId], references: [id])
  results      Result[]

  @@index([academicYearId])
  @@index([classId])
  @@index([schoolId])
}

model Result {
  id             String   @id @default(uuid())
  schoolId       String?
  studentId      String
  examId         String
  subjectId      String
  academicYearId String
  marksObtained  Float
  maxMarks       Float
  grade          String?
  percentage     Float?
  rank           Int?
  remarks        String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School?      @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])
  exam         Exam         @relation(fields: [examId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, examId, subjectId])
  @@index([examId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([schoolId])
}

// ==================== DOCUMENTS ====================

model Document {
  id         String   @id @default(uuid())
  schoolId   String?
  studentId  String
  name       String
  type       String   @default("OTHER")
  filePath   String
  fileSize   Int      @default(0)
  mimeType   String?
  uploadedAt DateTime @default(now())

  school  School? @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(uuid())
  schoolId  String?
  userId    String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([schoolId])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([schoolId])
}

// ==================== RECEIPT COUNTER ====================

model ReceiptCounter {
  id       String  @id @default(uuid())
  schoolId String?
  year     Int
  counter  Int     @default(0)

  school School? @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, year])
  @@index([schoolId])
}

model AdmissionCounter {
  id       String  @id @default(uuid())
  schoolId String?
  year     Int
  counter  Int     @default(0)

  school School? @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, year])
  @@index([schoolId])
}

// ==================== SCHOOL FEATURE TOGGLES ====================

model SchoolFeature {
  id        String   @id @default(uuid())
  schoolId  String
  featureId String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, featureId])
  @@index([schoolId])
}

// ==================== SYSTEM CONFIGURATION ====================

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

